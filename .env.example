# ── 护理质控上报系统（入站读 + 回写） ─────────────────────────────
# 必填：上报列表读取与整改结论回写的基地址
NURSING_QC_BASE_URL=https://nursing-qc.example-hospital.local
# 必填：质控系统接口令牌（出站请求头 Authorization: Bearer <token>）
NURSING_QC_TOKEN=

# ── 电子病历 EMR（入站读护理记录） ───────────────────────────────
# 必填：EMR 护理记录查询基地址
EMR_BASE_URL=https://emr.example-hospital.local
# 必填：EMR 接口令牌
EMR_API_TOKEN=

# ── 企业微信群机器人（出站催办） ─────────────────────────────────
# 必填：企微群机器人 webhook 地址
WECOM_WEBHOOK_URL=

# ── 模型网关（OpenAI-compatible，出站） ──────────────────────────
# 必填：模型服务基地址（院内自建端点或云服务均可）
MODEL_BASE_URL=https://model-gateway.example-hospital.local
# 必填：模型服务密钥
MODEL_API_KEY=
# 选填：模型名，默认 gpt-4o-mini
MODEL_NAME=gpt-4o-mini
# 选填：单次模型调用超时（毫秒），默认 30000；非法值回落默认值
MODEL_TIMEOUT=30000
# 选填：模型调用最大重试次数，默认 2
MODEL_MAX_RETRIES=2
# 选填：模型采样温度，默认 0.2
MODEL_TEMPERATURE=0.2

# ── 运行时节奏 ───────────────────────────────────────────────────
# 选填：上报轮询间隔（秒），默认 60
POLL_INTERVAL_SEC=60
# 选填：每日超期巡检时刻（HH:mm），默认 08:00
DAILY_SWEEP_AT=08:00
